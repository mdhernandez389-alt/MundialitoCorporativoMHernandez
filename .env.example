# Opcional. Copiar a .env (ignorado por git) para usar una contraseña propia en docker-compose.
# Sin .env se usa el valor de demo definido en docker-compose.yml.
# SQL Server exige al menos 8 caracteres con mayúsculas, minúsculas, números y símbolos.
# No usar ";" (rompería la cadena de conexión).
MSSQL_SA_PASSWORD=CambiaEstaClave_123!
